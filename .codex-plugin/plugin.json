  "interface": {
    "displayName": "\u4eba\u58f0\u53c2\u8003\u5bf9\u6bd4\u5206\u6790\u5668",
    "shortDescription": "\u7528\u4e00\u4e2a\u6216\u591a\u4e2a\u53c2\u8003\u7ec6\u5206\u8bca\u65ad\u4eba\u58f0\u97f3\u8272\u3001\u52a8\u6001\u3001\u7eb9\u7406\u548c\u58f0\u573a\u3002",
    "longDescription": "\u56fa\u5b9a\u4e00\u6761\u5f85\u8bc4\u4f30\u4eba\u58f0\uff0c\u4e0e\u4e00\u4e2a\u6216\u591a\u4e2a\u72ec\u5531\u3001Stem \u6216\u4eba\u58f0\u5206\u79bb\u53c2\u8003\u9010\u4e00\u8fdb\u884c\u54cd\u5ea6\u3001\u52a8\u6001\u9891\u6bb5\u3001\u4f4e\u4e2d\u9891\u906e\u853d\u3001\u54ac\u5b57\u3001\u5b8f\u5fae\u52a8\u6001\u3001\u8c10\u6ce2\u3001\u566a\u58f0\u7eb9\u7406\u3001\u9f7f\u97f3\u548c\u7a7a\u95f4\u7ed3\u6784\u8bca\u65ad\uff1b\u4fdd\u7559\u5b8c\u6574\u4e00\u5bf9\u4e00\u62a5\u544a\uff0c\u5e76\u4ee5\u53c2\u8003\u4e2d\u4f4d\u6570\u3001\u56db\u5206\u4f4d\u533a\u95f4\u3001\u65b9\u5411\u4e00\u81f4\u7387\u548c\u79bb\u7fa4\u5ea6\u5f52\u7eb3\u53c2\u8003\u5171\u6027\u4e0e\u4e2a\u6027\u3002\u6bcf\u4e2a\u72ec\u7acb\u5b50\u56fe\u5206\u522b\u6807\u6ce8\u53ef\u4fe1\u5ea6\u548c\u4e3b\u8981\u9650\u5236\uff0c\u53c2\u8003\u4e0d\u8db3\u65f6\u660e\u786e\u663e\u793a\u8bc1\u636e\u4e0d\u8db3\u3002",
    "developerName": "\u4e2a\u4eba Codex \u63d2\u4ef6",
    "category": "Creative",
    "capabilities": [
      "Analyze",
      "Visualize",
      "Write"
    ],
    "defaultPrompt": [
      "\u5c06\u6211\u7684\u4eba\u58f0\u6df7\u97f3\u4e0e\u591a\u4e2a\u53c2\u8003\u4eba\u58f0\u5bf9\u6bd4\uff0c\u751f\u6210\u53c2\u8003\u533a\u95f4\u3001\u5171\u6027\u3001\u4e2a\u6027\u548c\u53ef\u590d\u73b0\u63d2\u4ef6\u94fe\u3002",
      "\u5206\u6790\u6211\u7684\u4eba\u58f0\u4e0e\u8fd9\u4efd\u53c2\u8003\u5728\u9897\u7c92\u3001\u52a8\u6001\u3001\u9f7f\u97f3\u4e0e\u7a7a\u95f4\u611f\u4e0a\u7684\u5dee\u5f02\u3002",
      "\u68c0\u67e5\u53c2\u8003\u4e2d\u7684\u8d28\u611f\u54ea\u4e9b\u6765\u81ea\u771f\u5b9e\u5904\u7406\uff0c\u54ea\u4e9b\u53ef\u80fd\u662f\u4eba\u58f0\u5206\u79bb\u4f2a\u5f71\u3002",
      "\u5224\u65ad\u6211\u7684 Doubler \u4e3a\u4ec0\u4e48\u542c\u6210\u5de6\u4e2d\u53f3\u51e0\u4e2a\u70b9\uff0c\u800c\u53c2\u8003\u4e3a\u4ec0\u4e48\u50cf\u8fde\u7eed\u6269\u6563\u533a\u57df\u3002",
      "\u7ec6\u5206\u68c0\u67e5\u6211\u7684\u4eba\u58f0\u548c\u591a\u4e2a\u53c2\u8003\u7684\u52a8\u6001\u97f3\u8272\u3001\u5b57\u5934\u3001\u97f3\u8282\u5bc6\u5ea6\u3001\u5206\u9891\u52a8\u6001\u53ca\u89c4\u5219\u8c10\u6ce2\uff0c\u5e76\u4e3a\u6bcf\u4e2a\u5b50\u56fe\u6807\u6ce8\u53ef\u4fe1\u5ea6\u3002",
      "\u627e\u51fa\u591a\u4e2a\u53c2\u8003\u5171\u540c\u62e5\u6709\u4f46\u6211\u7684\u4eba\u58f0\u7f3a\u5c11\u7684\u7279\u5f81\uff0c\u540c\u65f6\u8bc6\u522b\u79bb\u7fa4\u53c2\u8003\uff0c\u907f\u514d\u7167\u6284\u5355\u66f2\u3002"
    ]

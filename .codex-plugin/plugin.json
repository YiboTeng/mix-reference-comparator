  "interface": {
    "displayName": "\u6df7\u97f3\u53c2\u8003\u5bf9\u6bd4\u5206\u6790\u5668",
    "shortDescription": "\u9009\u62e9\u5e72\u58f0\u6216\u5b8c\u6574\u6df7\u97f3\u6a21\u5f0f\uff0c\u4e0e\u4e00\u4e2a\u6216\u591a\u4e2a\u53c2\u8003\u8fdb\u884c\u53ef\u91cd\u590d\u8bca\u65ad\u3002",
    "longDescription": "Mix Reference Comparator \u63d0\u4f9b\u4e24\u4e2a\u7a33\u5b9a\u6a21\u5f0f\uff1acompare-vocal-references \u7528\u4e8e\u5e72\u58f0\u3001\u72ec\u5531\u3001Vocal Stem \u4e0e\u4eba\u58f0\u5206\u79bb\u53c2\u8003\uff1bcompare-mix-references \u7528\u4e8e\u5305\u542b\u4eba\u58f0\u548c\u4f34\u594f\u7684\u5b8c\u6574 Mix/Master\u3002\u5b8c\u6574\u6df7\u97f3\u6a21\u5f0f\u5728 Master-only \u8f93\u5165\u4e0b\u5206\u6790\u54cd\u5ea6\u3001\u52a8\u6001\u3001\u9891\u8c31\u3001\u7acb\u4f53\u58f0\u3001\u5355\u58f0\u9053\u517c\u5bb9\u548c\u6bb5\u843d\uff1b\u63d0\u4f9b\u53ef\u9760 Stem \u540e\u518d\u5206\u6790\u4eba\u58f0/\u4f34\u594f\u5e73\u8861\u3001\u906e\u853d\u3001\u7a7a\u95f4\u5173\u7cfb\u3001\u9f13\u3001Bass\u3001Lead/Pad \u4e0e\u7f16\u66f2\u5bc6\u5ea6\u3002\u6240\u6709\u72ec\u7acb\u5b50\u56fe\u5206\u522b\u6807\u6ce8\u53ef\u4fe1\u5ea6\u548c\u9650\u5236\u3002",
    "developerName": "\u4e2a\u4eba Codex \u63d2\u4ef6",
    "category": "Creative",
    "capabilities": [
      "Analyze",
      "Visualize",
      "Write"
    ],
    "defaultPrompt": [
      "\u542f\u52a8 Mix Reference Comparator\uff0c\u8bf7\u5148\u8ba9\u6211\u9009\u62e9\uff1a\u5e72\u58f0/\u4eba\u58f0\u53c2\u8003\u5bf9\u6bd4\uff0c\u6216\u5b8c\u6574\u6df7\u97f3\u6210\u54c1\u53c2\u8003\u5bf9\u6bd4\u3002",
      "\u5c06\u6211\u7684\u5b8c\u6574 Mix/Master \u4e0e\u591a\u4e2a\u53c2\u8003\u6df7\u97f3\u5bf9\u6bd4\uff1b\u6ca1\u6709 Stem \u65f6\u5148\u505a Master \u5c42\u5206\u6790\uff0c\u6709 Stem \u65f6\u518d\u5206\u6790\u4eba\u58f0\u4e0e\u4f34\u594f\u5173\u7cfb\u3002",
      "\u5c06\u6211\u7684\u4eba\u58f0\u6df7\u97f3\u4e0e\u591a\u4e2a\u53c2\u8003\u4eba\u58f0\u5bf9\u6bd4\uff0c\u751f\u6210\u53c2\u8003\u533a\u95f4\u3001\u5171\u6027\u3001\u4e2a\u6027\u548c\u53ef\u590d\u73b0\u63d2\u4ef6\u94fe\u3002",
      "\u5206\u6790\u6211\u7684\u4eba\u58f0\u4e0e\u8fd9\u4efd\u53c2\u8003\u5728\u9897\u7c92\u3001\u52a8\u6001\u3001\u9f7f\u97f3\u4e0e\u7a7a\u95f4\u611f\u4e0a\u7684\u5dee\u5f02\u3002",
      "\u68c0\u67e5\u53c2\u8003\u4e2d\u7684\u8d28\u611f\u54ea\u4e9b\u6765\u81ea\u771f\u5b9e\u5904\u7406\uff0c\u54ea\u4e9b\u53ef\u80fd\u662f\u4eba\u58f0\u5206\u79bb\u4f2a\u5f71\u3002",
      "\u5224\u65ad\u6211\u7684 Doubler \u4e3a\u4ec0\u4e48\u542c\u6210\u5de6\u4e2d\u53f3\u51e0\u4e2a\u70b9\uff0c\u800c\u53c2\u8003\u4e3a\u4ec0\u4e48\u50cf\u8fde\u7eed\u6269\u6563\u533a\u57df\u3002",
      "\u7ec6\u5206\u68c0\u67e5\u6211\u7684\u4eba\u58f0\u548c\u591a\u4e2a\u53c2\u8003\u7684\u52a8\u6001\u97f3\u8272\u3001\u5b57\u5934\u3001\u97f3\u8282\u5bc6\u5ea6\u3001\u5206\u9891\u52a8\u6001\u53ca\u89c4\u5219\u8c10\u6ce2\uff0c\u5e76\u4e3a\u6bcf\u4e2a\u5b50\u56fe\u6807\u6ce8\u53ef\u4fe1\u5ea6\u3002",
      "\u627e\u51fa\u591a\u4e2a\u53c2\u8003\u5171\u540c\u62e5\u6709\u4f46\u6211\u7684\u4eba\u58f0\u7f3a\u5c11\u7684\u7279\u5f81\uff0c\u540c\u65f6\u8bc6\u522b\u79bb\u7fa4\u53c2\u8003\uff0c\u907f\u514d\u7167\u6284\u5355\u66f2\u3002"
    ]
  }
